<?xml version="1.0" encoding="utf-8"?>
<!-- El panel de administración entero vive dentro de este WebView, que
     carga los archivos que ya tenemos (index.html, css, js) directamente
     desde dentro de la propia aplicación — no hace falta ninguna página
     web aparte para que funcione. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <WebView
        android:id="@+id/adminWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
